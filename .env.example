# EKOS Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ============================================================
# REQUIRED — The server will refuse to start without these
# ============================================================

# AES-256 master key for envelope encryption (minimum 32 chars)
EKOS_MASTER_KEY=change_me_to_a_secure_32char_key_

# JWT signing secret (minimum 32 chars)
EKOS_JWT_SECRET=change_me_to_a_different_jwt_secret

# Database credentials
POSTGRES_USER=ekos_user
POSTGRES_PASSWORD=change_me_strong_pg_password
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_neo4j_password
REDIS_PASSWORD=change_me_strong_redis_password

# ============================================================
# OPTIONAL — Sensible defaults are provided
# ============================================================

# Comma-separated list of allowed CORS origins
EKOS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL database name (default: ekos_db)
# POSTGRES_DB=ekos_db

# Server bind address and port
# EKOS_HOST=127.0.0.1
# EKOS_PORT=8000
# EKOS_RELOAD=false

# Discord channel integration public key (required to enable Discord webhooks)
# EKOS_DISCORD_PUBLIC_KEY=

# Qdrant collection name (default: ekos_knowledge)
# QDRANT_COLLECTION=ekos_knowledge

# S3 bucket for WORM audit snapshots
# WORM_BACKUP_BUCKET=s3://ekos-worm-audit-vault-us-east-1
